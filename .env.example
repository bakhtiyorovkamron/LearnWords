HTTP_ADDR=:8080
DATABASE_URL=postgres://learnwords:learnwords@localhost:5432/learnwords?sslmode=disable
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
SERVICE_NAME=learnwords-api
OTEL_EXPORTER_OTLP_ENDPOINT=
AUTO_MIGRATE=true
# AI example sentences (Anthropic). Without a key the "Сгенерировать автоматически" button returns 503.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# "German hero" for everyone who learns German. false → GET /api/hero answers 404 and the hero is
# hidden (a quick switch if a bug turns up; restart the backend to apply).
FEATURE_HERO_ENABLED=true
# Web Push. Empty keys = push is off (subscribe/send answer 503). Make a pair: go run ./cmd/vapidkeys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Buying photo credits (manual payment): a card to transfer to, or a Telegram contact where the
# payment is arranged — one of them is enough. Both empty = buying is off (the purchase endpoints
# answer 503 payments_unavailable). Server env only: never commit a real card number.
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=
# Telegram channel or user name (@name and https://t.me/name work too)
PAYMENT_TELEGRAM=
# Server monitoring (Beszel, panel via SSH tunnel) — see README «Мониторинг».
# Agent key and token from the panel's "Add system" dialog. Single quotes: KEY contains spaces.
BESZEL_KEY=
BESZEL_TOKEN=
