HTTP_ADDR=:8080
DATABASE_URL=postgres://learnwords:learnwords@localhost:5432/learnwords?sslmode=disable
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
SERVICE_NAME=learnwords-api
OTEL_EXPORTER_OTLP_ENDPOINT=
TRANSLATION_TARGET_LANG=ru
AUTO_MIGRATE=true
# AI example sentences (Anthropic). Without a key the "Сгенерировать автоматически" button returns 503.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
# "German hero" feature: comma-separated emails allowed to see GET /api/hero (everyone else
# gets a plain 404). Case-insensitive. Empty/unset = feature off for everyone.
FEATURE_HERO_EMAILS=
