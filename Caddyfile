# Caddy gets and renews the HTTPS certificate for these domains automatically (Let's Encrypt).
# DNS A records for yodla.fun and www.yodla.fun must point to this server first.
{
	email {$ACME_EMAIL:admin@yodla.fun}
}

www.yodla.fun {
	redir https://yodla.fun{uri} permanent
}

# Server monitoring (Beszel hub, see docker-compose.yml / README «Мониторинг»).
monitor.yodla.fun {
	encode zstd gzip

	# Extra login in front of Beszel's own. /api/* is left out: the Beszel web app sends its own
	# token in the Authorization header there (PocketBase), which basic auth would reject — and
	# that API requires a Beszel login anyway. User/hash come from .env; without them the default
	# hash below (of a random, discarded password) keeps the panel locked.
	@ui not path /api/*
	basic_auth @ui {
		{$BESZEL_BASIC_USER:admin} {$BESZEL_BASIC_HASH:$2a$12$2siEvm5bLdoXCwG/cPyt1.0.a0xI435o9bhRs6ZplgYl4xqdH6r1K}
	}

	reverse_proxy beszel:8090

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Requests by bare IP (http://129.121.97.22) or any unknown host → main domain.
# Without this Caddy closes the connection (ERR_EMPTY_RESPONSE).
http:// {
	redir https://yodla.fun{uri} permanent
}

# Old dev address http://129.121.97.22:15173 → main domain.
http://:15173 {
	redir https://yodla.fun{uri} permanent
}

yodla.fun {
	encode zstd gzip

	# API → Go backend (same origin, so the httpOnly refresh cookie works).
	handle /api/* {
		reverse_proxy backend:8080
	}

	# Everything else → built React app (SPA: unknown paths fall back to index.html).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Hashed assets can be cached forever. Everything else must be revalidated on every request:
	# index.html (also served for SPA paths like /cards), sw.js, the manifest, icons, offline.html —
	# otherwise the browser may keep an old index.html/sw.js after a deploy.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@notAssets not path /assets/* /api/*
	header @notAssets Cache-Control "no-cache"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
