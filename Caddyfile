# Caddy gets and renews the HTTPS certificate for these domains automatically (Let's Encrypt).
# DNS A records for yodla.fun and www.yodla.fun must point to this server first.
{
	email {$ACME_EMAIL:admin@yodla.fun}
}

www.yodla.fun {
	redir https://yodla.fun{uri} permanent
}

# Requests by bare IP (http://129.121.97.22) or any unknown host → main domain.
# Without this Caddy closes the connection (ERR_EMPTY_RESPONSE).
http:// {
	redir https://yodla.fun{uri} permanent
}

# Old dev address http://129.121.97.22:15173 → main domain.
http://:15173 {
	redir https://yodla.fun{uri} permanent
}

yodla.fun {
	encode zstd gzip

	# API → Go backend (same origin, so the httpOnly refresh cookie works).
	handle /api/* {
		reverse_proxy backend:8080
	}

	# Everything else → built React app (SPA: unknown paths fall back to index.html).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Hashed assets can be cached forever; index.html must always be fresh.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html
	header @html Cache-Control "no-cache"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
